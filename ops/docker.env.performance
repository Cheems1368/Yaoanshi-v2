# 性能优化环境配置
# 用于建立性能基线和优化系统性能

# JVM性能配置
JAVA_OPTS=-Xms2g -Xmx4g -XX:+UseG1GC -XX:MaxGCPauseMillis=100 -XX:+UseStringDeduplication -XX:+UnlockExperimentalVMOptions -XX:+UseCGroupMemoryLimitForHeap -Djava.security.egd=file:/dev/./urandom

# GC日志配置
JAVA_OPTS=$JAVA_OPTS -Xloggc:/app/logs/gc.log -XX:+PrintGCDetails -XX:+PrintGCTimeStamps -XX:+PrintGCDateStamps -XX:+UseGCLogFileRotation -XX:NumberOfGCLogFiles=5 -XX:GCLogFileSize=10M

# 应用配置
SPRING_PROFILES_ACTIVE=performance
SERVER_PORT=48080

# 数据库配置
DB_HOST=medicine-mysql
DB_PORT=3306
DB_NAME=medicine
DB_USERNAME=root
DB_PASSWORD=123456

# Redis配置
REDIS_HOST=medicine-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# 性能监控配置
PERFORMANCE_MONITORING_ENABLED=true
SLOW_QUERY_THRESHOLD=1000
SLOW_API_THRESHOLD=500
CIRCUIT_BREAKER_ENABLED=true

# 缓存配置
CACHE_DEFAULT_TTL=3600
CACHE_PATIENT_PROFILE_TTL=1800
CACHE_MEDICATION_PLAN_TTL=900
CACHE_TODAY_TASK_TTL=300
CACHE_ADHERENCE_STATS_TTL=7200
CACHE_REPORT_TTL=21600
