# ===========================================
# 用药打卡系统 - 环境变量配置模板
# ===========================================
# 复制此文件为 .env 并根据实际情况修改配置值

# ===========================================
# 数据库配置
# ===========================================
# MySQL数据库名称
MYSQL_DATABASE=medicine

# MySQL root用户密码 (生产环境必须修改)
MYSQL_ROOT_PASSWORD=your-secure-password-here

# ===========================================
# 应用服务配置
# ===========================================
# JVM启动参数
JAVA_OPTS=-Xms1024m -Xmx2048m -Djava.security.egd=file:/dev/./urandom

# 主数据源配置
MASTER_DATASOURCE_URL=jdbc:mysql://medicine-mysql:3306/${MYSQL_DATABASE}?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true
MASTER_DATASOURCE_USERNAME=root
MASTER_DATASOURCE_PASSWORD=${MYSQL_ROOT_PASSWORD}

# 从数据源配置（读写分离）
SLAVE_DATASOURCE_URL=${MASTER_DATASOURCE_URL}
SLAVE_DATASOURCE_USERNAME=${MASTER_DATASOURCE_USERNAME}
SLAVE_DATASOURCE_PASSWORD=${MASTER_DATASOURCE_PASSWORD}

# Redis配置
REDIS_HOST=medicine-redis

# ===========================================
# 前端管理端配置
# ===========================================
# Node.js环境
NODE_ENV=production

# 公共路径
PUBLIC_PATH=/

# 应用标题
VUE_APP_TITLE=用药打卡管理系统

# API基础路径
VUE_APP_BASE_API=/admin-api

# 应用名称
VUE_APP_APP_NAME=/

# 多租户开关
VUE_APP_TENANT_ENABLE=true

# 验证码开关
VUE_APP_CAPTCHA_ENABLE=true

# 文档开关
VUE_APP_DOC_ENABLE=true

# 百度统计代码
VUE_APP_BAIDU_CODE=fadc1bd5db1a1d6f581df60a1807f8ab

# ===========================================
# 开发环境配置
# ===========================================
# Spring Boot Profile
SPRING_PROFILES_ACTIVE=local

# 开发模式开关
DEV_MODE=true

# 调试端口
DEBUG_PORT=5005

# ===========================================
# 生产环境配置
# ===========================================
# 生产环境数据库连接池大小
DB_POOL_SIZE=20

# 生产环境Redis连接池大小
REDIS_POOL_SIZE=10

# 生产环境日志级别
LOG_LEVEL=INFO

# ===========================================
# 安全配置
# ===========================================
# JWT密钥（生产环境必须修改）
JWT_SECRET=your-jwt-secret-key-here-change-in-production

# Token过期时间（秒）
JWT_EXPIRATION=86400

# Mock模式密钥（仅开发环境使用）
MOCK_SECRET=test

# ===========================================
# 监控配置
# ===========================================
# Actuator端点暴露
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus

# 健康检查路径
MANAGEMENT_ENDPOINT_HEALTH_SHOW_DETAILS=always

# ===========================================
# 文件存储配置
# ===========================================
# 文件上传路径
FILE_UPLOAD_PATH=/app/files

# 文件访问URL前缀
FILE_ACCESS_URL_PREFIX=/files

# 最大文件大小（MB）
MAX_FILE_SIZE=10

# ===========================================
# 通知配置
# ===========================================
# 短信服务开关
SMS_ENABLED=false

# 邮件服务开关
EMAIL_ENABLED=false

# 推送服务开关
PUSH_ENABLED=true

# ===========================================
# 业务配置
# ===========================================
# 用药提醒默认提前时间（分钟）
MEDICATION_REMINDER_ADVANCE_MINUTES=15

# 依从性统计周期（天）
ADHERENCE_STATISTICS_PERIOD=30

# 报告生成周期（天）
REPORT_GENERATION_PERIOD=90

# 药师最大匹配患者数
PHARMACIST_MAX_PATIENTS=50

# 医生最大匹配患者数
DOCTOR_MAX_PATIENTS=100
