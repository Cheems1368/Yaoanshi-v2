## mysql
MYSQL_DATABASE=medicine
MYSQL_ROOT_PASSWORD=123456

## server
JAVA_OPTS=-Xms1g -Xmx2g -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+UseStringDeduplication -Djava.security.egd=file:/dev/./urandom

MASTER_DATASOURCE_URL=jdbc:mysql://medicine-mysql:3306/${MYSQL_DATABASE}?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&nullCatalogMeansCurrent=true
MASTER_DATASOURCE_USERNAME=root
MASTER_DATASOURCE_PASSWORD=${MYSQL_ROOT_PASSWORD}
SLAVE_DATASOURCE_URL=${MASTER_DATASOURCE_URL}
SLAVE_DATASOURCE_USERNAME=${MASTER_DATASOURCE_USERNAME}
SLAVE_DATASOURCE_PASSWORD=${MASTER_DATASOURCE_PASSWORD}
REDIS_HOST=medicine-redis

## admin
NODE_ENV=production
PUBLIC_PATH=/
VUE_APP_TITLE=药学管理系统
VUE_APP_BASE_API=/admin-api
VUE_APP_APP_NAME=/
VUE_APP_TENANT_ENABLE=true
VUE_APP_CAPTCHA_ENABLE=true
VUE_APP_DOC_ENABLE=true
VUE_APP_BAIDU_CODE=fadc1bd5db1a1d6f581df60a1807f8ab

# 禁用演示模式
MEDICINE_DEMO=false
SPRING_PROFILES_ACTIVE=local

# 禁用所有集成服务以避免健康检查超时
MEDICINE_INTEGRATION_DRUG_ENABLED=false
MEDICINE_INTEGRATION_COMMON_ENABLED=false
MEDICINE_INTEGRATION_PATIENT_ENABLED=false
MEDICINE_INTEGRATION_USER_PERMISSION_ENABLED=false
MEDICINE_HEALTH_CUSTOM_ENABLED=false

# 禁用健康检查超时限制
MANAGEMENT_HEALTH_DB_ENABLED=false
MANAGEMENT_HEALTH_REDIS_ENABLED=false
MANAGEMENT_HEALTH_DISKSPACE_ENABLED=false
MANAGEMENT_HEALTH_DEFAULTPING_ENABLED=false
