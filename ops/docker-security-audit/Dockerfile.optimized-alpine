# 药学管理系统 - Alpine优化版Dockerfile
# 基于Alpine Linux，最小化镜像体积

FROM openjdk:11-jre-slim AS base

# 安装必要的运行时工具
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        dumb-init \
        tzdata \
        ca-certificates \
        fontconfig \
        fonts-dejavu-core \
        fonts-wqy-zenhei \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# 创建非root用户和组
RUN groupadd -r appgroup && \
    useradd -r -g appgroup -d /app -s /bin/bash appuser

# 设置时区
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# 创建应用目录并设置权限
RUN mkdir -p /app/logs /app/tmp && \
    chown -R appuser:appgroup /app

# 设置工作目录
WORKDIR /app

# 复制JAR文件
COPY medicine-server/target/medicine-server.jar app.jar

# 设置文件权限
RUN chown appuser:appgroup app.jar && \
    chmod 755 app.jar

# 切换到非root用户
USER appuser

# =============================================================================
# 环境变量配置
# =============================================================================
# JVM容器化支持参数
ENV JAVA_OPTS="-XX:+UseContainerSupport \
    -XX:MaxRAMPercentage=70.0 \
    -XX:InitialRAMPercentage=50.0 \
    -XX:MaxMetaspaceSize=256m \
    -XX:+HeapDumpOnOutOfMemoryError \
    -XX:HeapDumpPath=/app/tmp/heapdump.hprof \
    -XX:+UseG1GC \
    -XX:MaxGCPauseMillis=200 \
    -XX:+UseStringDeduplication \
    -Djava.security.egd=file:/dev/./urandom \
    -Djava.awt.headless=true \
    -Dfile.encoding=UTF-8 \
    -Dserver.shutdown=graceful"

# Spring Boot配置
ENV SPRING_PROFILES_ACTIVE=prod
ENV ARGS=""

# 暴露端口
EXPOSE 48080

# =============================================================================
# 健康检查
# =============================================================================
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:48080/actuator/health || exit 1

# =============================================================================
# 启动命令
# =============================================================================
# 使用dumb-init作为PID 1，确保信号正确传递
ENTRYPOINT ["dumb-init", "--"]
CMD ["sh", "-c", "java $JAVA_OPTS -jar app.jar $ARGS"]

