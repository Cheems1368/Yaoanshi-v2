# Copy this file to ops/.env.backend-v2.local for Docker or Portainer local stacks.
# This file is optional. If it is absent, backend-v2 still starts and falls back to
# application defaults from backend-v2/src/main/resources/application.yml.
# Keep database, Redis, and MinIO host settings in ops/docker-compose.yml so containers
# continue to use service names such as mysql, redis, and minio.

# AI assistant secret
MEDICINE_AI_API_KEY=replace-with-your-siliconflow-api-key

# Local OCR is supported by the Windows host-run stack. Docker backend falls back
# to manual review; it cannot reach the host's loopback-only OCR service.

# XFYUN help-order speech transcription
MEDICINE_XFYUN_APP_ID=
MEDICINE_XFYUN_API_KEY=
MEDICINE_XFYUN_API_SECRET=
MEDICINE_XFYUN_BASE_URL=wss://iat-api.xfyun.cn/v2/iat
MEDICINE_XFYUN_PRIMARY_DOMAIN=xfime-mianqie
MEDICINE_XFYUN_FALLBACK_DOMAIN=iat
MEDICINE_XFYUN_TIMEOUT_MS=30000
