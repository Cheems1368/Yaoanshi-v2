# Copy this file to .env.local and fill in your local secrets.
# The local run script defaults SPRING_PROFILES_ACTIVE=local so local DB/Redis config stays active.
MEDICINE_AI_API_KEY=replace-with-your-siliconflow-api-key

# DeepSeek OCR via SiliconFlow — reuse the same API key as AI assistant.
# Leave MEDICINE_OCR_API_KEY blank to disable OCR (graceful fallback to MANUAL_REVIEW_REQUIRED).
MEDICINE_OCR_API_KEY=replace-with-your-siliconflow-api-key
MEDICINE_OCR_BASE_URL=https://api.siliconflow.cn/v1/chat/completions
MEDICINE_OCR_MODEL=deepseek-ai/deepseek-vl2
MEDICINE_OCR_TIMEOUT_MS=30000
MEDICINE_AI_BASE_URL=https://api.siliconflow.cn/v1/chat/completions
MEDICINE_AI_MODEL=zai-org/GLM-4.5-Air
MEDICINE_AI_PROTOCOL=OPENAI_CHAT
MEDICINE_AI_ENABLE_THINKING=false
MEDICINE_AI_MAX_TOKENS=2048
MEDICINE_AI_TIMEOUT_MS=15000
MEDICINE_AI_UPSTREAM_MAX_MESSAGES=10

# XFYUN voice dictation for help-order voice transcription.
# Fill these only in backend-v2/.env.local. Leave blank to keep voice sending enabled
# while transcription returns unavailable.
MEDICINE_XFYUN_APP_ID=
MEDICINE_XFYUN_API_KEY=
MEDICINE_XFYUN_API_SECRET=
MEDICINE_XFYUN_BASE_URL=wss://iat-api.xfyun.cn/v2/iat
MEDICINE_XFYUN_PRIMARY_DOMAIN=xfime-mianqie
MEDICINE_XFYUN_FALLBACK_DOMAIN=iat
MEDICINE_XFYUN_TIMEOUT_MS=30000

# MinIO / S3-compatible object storage (defaults match local docker-compose minio service).
# Override these if connecting to a remote MinIO or AWS S3 instance.
MEDICINE_STORAGE_ENDPOINT=http://127.0.0.1:9000
MEDICINE_STORAGE_ACCESS_KEY=minioadmin
MEDICINE_STORAGE_SECRET_KEY=minioadmin
MEDICINE_STORAGE_BUCKET=yaoanshi-mvp
MEDICINE_STORAGE_REGION=us-east-1

# Optional local overrides. The run script will auto-fill DB password from ops/docker.env,
# mirror MEDICINE_LEGACY_DB_PASSWORD from MEDICINE_DB_PASSWORD, default Redis port to 16379,
# and default JWT secret to local-dev-jwt-secret-change-me when omitted.
# MEDICINE_JWT_SECRET=local-dev-jwt-secret-change-me
# MEDICINE_DB_PASSWORD=replace-if-not-using-default-local-password
# MEDICINE_LEGACY_DB_PASSWORD=replace-if-different-from-main-db-password
# MEDICINE_REDIS_PORT=16379
