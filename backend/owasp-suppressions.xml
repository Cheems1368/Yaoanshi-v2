<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!-- 排除已知的误报 -->
    <suppress>
        <notes><![CDATA[
        排除Spring Boot相关的误报，这些是框架内部使用的依赖
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.boot/.*$</packageUrl>
    </suppress>
    
    <!-- 排除测试依赖的漏洞检查 -->
    <suppress>
        <notes><![CDATA[
        排除测试框架相关的漏洞检查
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.junit\.jupiter/.*$</packageUrl>
    </suppress>
    
    <!-- 排除Lombok相关的检查 -->
    <suppress>
        <notes><![CDATA[
        排除Lombok相关的检查，这是编译时工具
        ]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.projectlombok/.*$</packageUrl>
    </suppress>
</suppressions>
